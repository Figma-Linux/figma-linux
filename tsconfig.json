{
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "noImplicitAny": true,
    "allowJs": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "preserveConstEnums": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": true,
    "allowUnusedLabels": false,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ],
    "paths": {
      "Main": ["src/main"],
      "Main/*": ["src/main/*"],
      "Shared": ["src/renderer/shared"],
      "Shared/*": ["src/renderer/shared/*"],
      "Features": ["src/renderer/features"],
      "Features/*": ["src/renderer/features/*"],
      "Const": ["src/constants"],
      "Const/*": ["src/constants/*"],
      "Utils": ["src/utils"],
      "Utils/*": ["src/utils/*"],
      "Enums": ["src/types/enums.ts"],
      "Storage": ["src/main/Storage.ts"],
      "Types": ["src/types"],
      "Types/*": ["src/types/*"],
      "*": ["node_modules/@types/*"]
    }
  },
  "include": [
    "src/constants/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/renderer/**/*"
  ]
}
